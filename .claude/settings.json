{
  "extraKnownMarketplaces": {
    "honsha": {
      "source": { "source": "github", "repo": "twoends/honsha" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "honsha@honsha": true
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/checks/pushed.mjs\" && node \"$CLAUDE_PROJECT_DIR/checks/pushed.mjs\" --install || true"
          }
        ]
      }
    ]
  }
}

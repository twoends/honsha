{
  "name": "honsha",
  "private": true,
  "description": "Development tools for the kit's own checks. The plugin needs none of them to run.",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12 <13",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint-plugin-security": "4.2.1",
    "oxlint": "1.94.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
